{
  "id": "/run-vision/",
  "name": "RunVision — карточки и видео пробежек",
  "short_name": "RunVision",
  "description": "Превращает GPX-тренировку в карточку или видео для Instagram Stories и Reels",
  "lang": "ru",
  "start_url": "/run-vision/",
  "scope": "/run-vision/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0b",
  "theme_color": "#0a0a0b",
  "categories": ["sports", "health", "photo"],
  "icons": [
    {
      "src": "/run-vision/icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/run-vision/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/run-vision/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/run-vision/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/run-vision/",
      "accept": {
        "application/gpx+xml": [".gpx"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "/run-vision/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "gpx",
          "accept": [".gpx", "application/gpx+xml", "application/octet-stream", "text/xml"]
        }
      ]
    }
  }
}
